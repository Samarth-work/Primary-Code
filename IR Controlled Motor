#define IR_PIN 27
// Motor-1
#define IN1 26
#define IN2 25

// Motor-2
#define IN3 33
#define IN4 32


void setup() {
  pinMode(IR_PIN, INPUT);
  pinMode(IN2, OUTPUT);
  digitalWrite(IN2, LOW);

  ledcAttach(IN1, 1000, 8);
}

void loop() {
  if (digitalRead(IR_PIN) == LOW) {   // Object detected
    ledcWrite(IN1, 200);
  } else {
    ledcWrite(IN1, 0);
  }
}
